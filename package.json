{
  "name": "lightrag-ts",
  "version": "0.0.0",
  "description": "TypeScript port of HKUDS/LightRAG v1.4.16: graph-based RAG that reads and writes the upstream storage format",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SCOPE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "test:upstream": "node tools/upstream/run-upstream-tests.ts",
    "store:stats": "node scripts/store-stats.ts",
    "parity:extract": "node parity/replay-extract.ts",
    "parity:storages": "node parity/storages.ts",
    "parity:operate": "node parity/operate.ts",
    "parity:query": "node parity/query.ts keys",
    "parity:query-context": "node parity/query-context.ts",
    "smoke:live": "node parity/live-smoke.ts"
  },
  "keywords": [
    "rag",
    "graphrag",
    "lightrag",
    "knowledge-graph",
    "llm"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pako": "^2.0.4",
    "graphology-types": "^0.24.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "js-tiktoken": "1.0.21",
    "pako": "2.1.0",
    "saxes": "^6.0.0"
  }
}
